# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr → 인증키 신청)
# 없으면 샘플 키로 5건만 받아옵니다.
SEOUL_API_KEY=

# 공공데이터포털 일반 인증키(Decoding) — 기상청 단기·중기예보, 한국천문연구원 특일정보
DATA_GO_KR_KEY=

# 카카오 개발자 콘솔 JavaScript 키 (없으면 OpenStreetMap 지도로 대체)
VITE_KAKAO_MAP_KEY=

# 카카오 REST API 키 — 테니스장별 카카오맵 장소(후기 링크·주소) 매칭용 (빌드 시에만 사용)
KAKAO_REST_KEY=
